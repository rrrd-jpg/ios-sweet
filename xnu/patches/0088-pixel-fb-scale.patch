+/* Nearest-neighbour blit of a logical-display rect onto the panel (sweetfb_scale). */
+static void
+sweet_fb_blit_scaled(uintptr_t pixels, uint32_t rowBytes, uint32_t pw, uint32_t ph,
+	uint32_t lw, uint32_t lh, uintptr_t src, uint32_t srcBpr,
+	int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	int64_t px0 = ((int64_t)dx * pw) / lw;
+	int64_t px1 = (((int64_t)(dx + w) * pw) + lw - 1) / lw;
+	int64_t py0 = ((int64_t)dy * ph) / lh;
+	int64_t py1 = (((int64_t)(dy + h) * ph) + lh - 1) / lh;
+	if (px1 > (int64_t)pw) {
+		px1 = pw;
+	}
+	if (py1 > (int64_t)ph) {
+		py1 = ph;
+	}
+	if (px0 >= px1 || py0 >= py1) {
+		return;
+	}
+	uint64_t stepx = ((uint64_t)lw << 16) / pw;
+	uint64_t stepy = ((uint64_t)lh << 16) / ph;
+	for (int64_t py = py0; py < py1; py++) {
+		int32_t row = (int32_t)(((uint64_t)py * stepy) >> 16) - dy;
+		row = row < 0 ? 0 : (row > h - 1 ? h - 1 : row);
+		const uint32_t *srow = (const uint32_t *)(src + (uint64_t)(sy + row) * srcBpr + (uint64_t)sx * 4);
+		uint32_t *drow = (uint32_t *)(pixels + (uint64_t)py * rowBytes);
+		uint64_t fx = (uint64_t)px0 * stepx;
+		for (int64_t px = px0; px < px1; px++, fx += stepx) {
+			int32_t col = (int32_t)(fx >> 16) - dx;
+			col = col < 0 ? 0 : (col > w - 1 ? w - 1 : col);
+			drow[px] = srow[col];
+		}
+	}
+}
