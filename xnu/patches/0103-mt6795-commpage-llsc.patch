diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..a6ab943 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,7 +273,20 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if defined(SWEET_MT6795)
+	// ARMv8.0 has no LSE: LL/SC equivalent of the casa below
+Ltrylock_enqueue_ll:
+	ldaxr	w10, [x3]		// acquire load of the lock
+	cbz	w10, Ltrylock_enqueue_try
+	clrex				// lock held: w10 != 0 takes the failure path
+	b	Ltrylock_enqueue_done
+Ltrylock_enqueue_try:
+	stxr	w12, w11, [x3]
+	cbnz	w12, Ltrylock_enqueue_ll	// monitor lost: retry
+Ltrylock_enqueue_done:
+#else
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+#endif
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +336,20 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if defined(SWEET_MT6795)
+	// ARMv8.0 has no LSE: LL/SC equivalent of the casa below
+Ltrylock_dequeue_ll:
+	ldaxr	w10, [x2]		// acquire load of the lock
+	cbz	w10, Ltrylock_dequeue_try
+	clrex				// lock held: w10 != 0 takes the failure path
+	b	Ltrylock_dequeue_done
+Ltrylock_dequeue_try:
+	stxr	w12, w11, [x2]
+	cbnz	w12, Ltrylock_dequeue_ll	// monitor lost: retry
+Ltrylock_dequeue_done:
+#else
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+#endif
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
